# Copy to .env for local development (not used by Docker; see compose.yaml).
PORT=8080
APP_ORIGIN=http://127.0.0.1:8080
# DATABASE_PATH=/absolute/path/to/statistics.sqlite
ADMIN_USERNAME=Administrator
# Generate with: node scripts/hash-password.mjs 'your password'
ADMIN_PASSWORD_HASH=
# Optional: trust X-Statistics-Client-IP only from a proxy that sends this token.
# STATISTICS_PROXY_TOKEN=
# Optional offline GeoIP database (MaxMind/DB-IP .mmdb).
# STATISTICS_GEOIP_DATABASE=/data/geoip/city.mmdb
